#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
usage() {
    cat <<'EOF'
Usage: ./setup <check|packages|preview|plan|apply>
  check     Check deployment, TeX dependencies and configuration (no changes).
  packages  Arch/CachyOS: install the manifest with a full pacman upgrade.
  preview   Linux: deploy only TeX preview links; leave the Neovim config untouched.
  plan      macOS: build without switching. Linux: preview all Stow links.
  apply     macOS: nix-darwin switch. Linux: apply all Stow links after preflight.
Run as your normal user. Package installation and macOS apply invoke sudo.
EOF
}
fail() { printf 'setup: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "Missing command: $1"; }
action="${1:-help}"
[[ $# -le 1 ]] || { usage >&2; exit 2; }
case "$action" in
    help|-h|--help) usage; exit 0 ;;
    check|packages|preview|plan|apply) ;;
    *) usage >&2; exit 2 ;;
esac
case "$(uname -s)" in
    Darwin) platform=macos ;;
    Linux) platform=linux ;;
    *) fail "Unsupported platform: $(uname -s)" ;;
esac
[[ "$(id -u)" != 0 ]] || fail 'Run as your normal user.'
printf 'Platform: %s\nRepository: %s\n' "$platform" "$REPO_ROOT"
if [[ "$action" == packages ]]; then
    [[ "$platform" == linux ]] || fail 'macOS packages are managed by ./setup apply.'
    need pacman; need sudo
    packages=()
    while IFS= read -r package || [[ -n "$package" ]]; do
        [[ -z "$package" || "$package" == \#* ]] && continue
        [[ "$package" =~ ^[a-zA-Z0-9@._+-]+$ ]] || fail "Invalid package: $package"
        packages+=("$package")
    done < "$REPO_ROOT/packages/cachyos/pacman.txt"
    exec sudo pacman -Syu --needed -- "${packages[@]}"
fi
if [[ "$action" == preview ]]; then
    need python3
    exec python3 "$REPO_ROOT/scripts/manage.py" "$action"
fi
if [[ "$action" == check ]]; then
    missing=0
    if [[ "$platform" == macos ]]; then
        required=(nix darwin-rebuild zsh python3 ssh nvim latexmk lualatex biber latexminted)
    else
        required=(stow git zsh tmux python3 ssh nvim latexmk lualatex biber latexminted zathura)
    fi
    for tool in "${required[@]}"; do
        if command -v "$tool" >/dev/null 2>&1; then
            printf 'OK: %s\n' "$tool"
        else
            printf 'Missing: %s\n' "$tool" >&2; missing=1
        fi
    done
    bash -n "$REPO_ROOT/setup" "$REPO_ROOT/dotfiles/common/.local/bin/pdf-opener" \
        "$REPO_ROOT/dotfiles/common/.local/bin/tmux-sessionizer" \
        "$REPO_ROOT/dotfiles/common/.local/bin/remote-tex-preview"
    if command -v zsh >/dev/null 2>&1; then zsh -n "$REPO_ROOT/dotfiles/common/.zshrc"; fi
    if command -v python3 >/dev/null 2>&1; then
        python3 "$REPO_ROOT/scripts/manage.py" check || missing=1
    fi
    for tool in fzf fd eza bat zoxide oh-my-posh yazi; do
        command -v "$tool" >/dev/null 2>&1 || printf 'Optional tool missing: %s\n' "$tool"
    done
    exit "$missing"
fi
if [[ "$platform" == macos ]]; then
    need nix
    flake="path:$REPO_ROOT#macbookpro"
    if [[ "$action" == plan ]]; then
        exec nix build --no-link --no-write-lock-file \
            "path:$REPO_ROOT#darwinConfigurations.macbookpro.config.system.build.toplevel"
    fi
    need darwin-rebuild; need sudo
    exec sudo "$(command -v darwin-rebuild)" switch --flake "$flake"
fi
need stow; need zsh; need git; need tmux
zsh -n "$REPO_ROOT/dotfiles/common/.zshrc"
[[ -z "${XDG_CONFIG_HOME:-}" || "$XDG_CONFIG_HOME" == "$HOME/.config" ]] || \
    fail 'This layout uses ~/.config; custom XDG_CONFIG_HOME is unsupported.'
[[ -z "${XDG_DATA_HOME:-}" || "$XDG_DATA_HOME" == "$HOME/.local/share" ]] || \
    fail 'This layout uses ~/.local/share; custom XDG_DATA_HOME is unsupported.'
stow_args=(--dir="$REPO_ROOT/dotfiles" --target="$HOME" --no-folding --ignore='\.gitkeep$' --verbose)
stow "${stow_args[@]}" --simulate common linux
if [[ "$action" == apply ]]; then stow "${stow_args[@]}" common linux; fi
