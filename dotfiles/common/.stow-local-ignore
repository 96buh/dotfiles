# Match basenames: patterns containing / use Stow's full-path matching.
^\.(git|gitkeep|DS_Store)$
^(__pycache__|\.pytest_cache|\.ruff_cache|\.mypy_cache|\.cache|\.venv|\.direnv|node_modules|htmlcov)$
.*\.py[cod]$
^config\.local(\..*)?$
^(local\.zsh|auth\.json|coverage\.xml)$
^\.coverage(\..*)?$
^\.env$
^\.env\.(?!(example|sample|template)$).*$
# Full package-relative paths for writable agent state.
^/\.codex/(config\.toml|history\.jsonl|sessions|backups)(/.*)?$
^/\.pi/agent/(settings\.json|sessions)(/.*)?$
.*\.(swp|swo|bak)$
.*~$
.*\.before-.*
