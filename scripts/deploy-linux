#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
stow_args=(--no-folding --restow --verbose --dir "$repo_dir/dotfiles" --target "$HOME")
if [[ "${1:-}" == "--check" && $# == 1 ]]; then
  stow_args+=(--simulate)
elif [[ $# != 0 ]]; then
  echo "Usage: $0 [--check]" >&2
  exit 2
fi

command -v uv >/dev/null || { echo "Install uv before deploying." >&2; exit 1; }
command -v stow >/dev/null || { echo "Install GNU Stow before deploying." >&2; exit 1; }
apply_settings() {
  uv run --no-project --script "$repo_dir/scripts/apply-agent-settings.py" \
    --source "$repo_dir/dotfiles/settings/codex.toml" \
    --target "${CODEX_HOME:-$HOME/.codex}/config.toml" "$@"
  uv run --no-project --script "$repo_dir/scripts/apply-agent-settings.py" \
    --source "$repo_dir/dotfiles/settings/pi.json" \
    --target "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/settings.json" "$@"
}

# Validate both configs and prepare dependencies before changing home links.
apply_settings --check
stow "${stow_args[@]}" common linux
if [[ $# == 0 ]]; then
  apply_settings
fi
